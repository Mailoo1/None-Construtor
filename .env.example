# Copia este archivo como ".env" (sin ".example") y pega ahí tus valores
# reales, tomados de tu proyecto en la consola de Firebase
# (Configuración del proyecto > Tus apps > SDK setup and configuration).
#
# IMPORTANTE: agrega ".env" a tu archivo .gitignore para que nunca se
# suba al repositorio.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
